{
  "name": "@interop/http-signature-zcap-invoke",
  "version": "6.2.4",
  "description": "A library for invoking Authorization Capabilities via HTTP signatures",
  "license": "BSD-3-Clause",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "types": "./lib/index.d.ts",
  "browser": {
    "./lib/util.js": "./lib/util-browser.js"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "scripts": {
    "test": "npm run test-node",
    "test-node": "cross-env NODE_ENV=test mocha --preserve-symlinks -t 30000 -A -R ${REPORTER:-spec} --require tests/test-mocha.js tests/*.spec.js",
    "test-karma": "karma start karma.conf.cjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@interop/data-integrity-core": "^8.3.0",
    "@interop/http-digest-header": "^3.0.0",
    "@interop/http-signature-header": "^5.0.2",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@digitalbazaar/ed25519-signature-2020": "^5.4.0",
    "@digitalbazaar/http-signature-zcap-verify": "^11.2.0",
    "@digitalbazaar/zcap": "^9.0.0",
    "chai": "^4.3.6",
    "cross-env": "^10.1.0",
    "ed25519-signature-2020-context": "^1.1.0",
    "eslint": "^8.57.1",
    "eslint-config-digitalbazaar": "^5.2.0",
    "eslint-plugin-jsdoc": "^50.8.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "jsonld-signatures": "^11.6.0",
    "karma": "^6.3.20",
    "karma-chai": "^0.1.0",
    "karma-chrome-launcher": "^3.1.1",
    "karma-mocha": "^2.0.1",
    "karma-mocha-reporter": "^2.2.5",
    "karma-sourcemap-loader": "^0.4.0",
    "karma-webpack": "^5.0.0",
    "mocha": "^11.7.4",
    "mocha-lcov-reporter": "^1.3.0",
    "security-context": "^4.0.0",
    "webpack": "^5.73.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/interop-alliance/http-signature-zcap-invoke"
  },
  "keywords": [
    "authorization",
    "capability",
    "authorization capability",
    "object capability",
    "ocap-ld",
    "http signature",
    "http signatures",
    "zcap",
    "zcaps"
  ],
  "author": {
    "name": "Digital Bazaar, Inc.",
    "email": "support@digitalbazaar.com",
    "url": "https://digitalbazaar.com/"
  },
  "bugs": {
    "url": "https://github.com/digitalbazaar/http-signature-zcap-invoke/issues"
  },
  "homepage": "https://github.com/digitalbazaar/http-signature-zcap-invoke",
  "engines": {
    "node": ">=20"
  }
}
